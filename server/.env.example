GOOGLE_GENERATIVE_AI_API_KEY=tu-key-de-https://aistudio.google.com/apikey
OPENAI_API_KEY=tu-key-de-https://platform.openai.com/api-keys

# Auth (Supabase Auth, no MCP -- ver constitution.md 3.3). Sacar de
# Supabase → Project Settings → API: "Project URL" y "anon public" key.
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Necesario para que server/ pueda spawnear mcp-server/ por stdio (mismo
# Postgres que usa mcp-server/.env).
DATABASE_URL=postgresql://usuario:password@localhost:5432/mosaico

# TEMPORAL: mientras el login no emita tokens, las peticiones sin
# Authorization se atienden como este usuario. Quitar cuando exista auth
# real -- con esto puesto, cualquiera que alcance el server entra como el.
AUTH_USUARIO_SIN_TOKEN=demo-user
