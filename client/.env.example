# Backend Next.js (server/, ver server/app/api/agent). Copia a .env y ajusta
# segun donde corras (server/ corre en el puerto 3000 por default):
#   - Expo web (misma maquina): http://localhost:3000
#   - Emulador Android: http://10.0.2.2:3000 (alias del host dentro del emulador)
#   - Telefono real (misma WiFi): http://<IP-LAN-de-tu-PC>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
