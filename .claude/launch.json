{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mosaico-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mosaico-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "web"
      ],
      "port": 8081
    }
  ]
}
